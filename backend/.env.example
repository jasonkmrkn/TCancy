# --- PostgreSQL ---
POSTGRES_USER=tcancy
POSTGRES_PASSWORD=tcancy
POSTGRES_DB=tcancy

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000

# Filled by setup-env.sh
SESSION_SECRET=
MASTER_KEY=
BLIND_INDEX_KEY=

COOKIE_SECURE=false
ENCRYPTION_POLICY=assignment
INTEGRITY_MODE=off

IDENTITY_ACCESS_DAYS=28
DOWNLOAD_LIMIT_PER_HOUR=20
ACCESS_REMINDER_DAYS=3

REDIS_URL=
# Port host untuk service redis (hanya terbuka di 127.0.0.1). Ganti bila 6379 sudah dipakai.
REDIS_HOST_PORT=6379

TRUSTED_PROXIES=
RATE_REGISTER_LIMIT=
RATE_REGISTER_WINDOW_SECONDS=

RATE_LOGIN_IP_LIMIT=
RATE_LOGIN_IP_WINDOW_SECONDS=

RATE_LOGIN_USER_LIMIT=
RATE_LOGIN_USER_WINDOW_SECONDS=

RATE_DELETE_ACCOUNT_LIMIT=
RATE_DELETE_ACCOUNT_WINDOW_SECONDS=